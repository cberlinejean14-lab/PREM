                            <% }) %>
                        <% } else { %>
                            <li class="ranking-item" style="color: var(--text-muted); justify-content: center; border: none; padding-top: 25px;"><%= t.noRecords %></li>
                        <% } %>
                    </ul>
                </div>

                <!-- 2. Top Actividad / XP -->
                <div class="glass-card podium-card center-card">
                    <div class="card-icon"><i class="fa-solid fa-trophy"></i></div>
                    <h3><%= t.topActivity %></h3>
                    <ul class="ranking-list">
                        <% if (typeof rankingXP !== 'undefined' && rankingXP.length > 0) { %>
                            <% rankingXP.forEach((user, index) => { %>
                                <li class="ranking-item">
                                    <span class="ranking-user">
                                        <span style="font-weight: 700; color: var(--accent-color);">#<%= index + 1 %></span>
                                        <img src="<%= user.avatar %>" alt="Avatar" style="width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-color); margin-left: 4px;">
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100px;"><%= user.username %></span>
                                    </span>
                                    <span class="ranking-value"><%= user.value.toLocaleString() %> XP</span>
                                </li>
                            <% }) %>
                        <% } else { %>
                            <li class="ranking-item" style="color: var(--text-muted); justify-content: center; border: none; padding-top: 25px;"><%= t.noRecords %></li>
                        <% } %>
                    </ul>
                </div>

                <!-- 3. Top Melómanos / Música -->
                <div class="glass-card podium-card side-card">
                    <div class="card-icon"><i class="fa-solid fa-music"></i></div>
                    <h3><%= t.topMusic %></h3>
                    <ul class="ranking-list">
                        <% if (typeof rankingMusica !== 'undefined' && rankingMusica.length > 0) { %>
                            <% rankingMusica.forEach((user, index) => { %>
                                <li class="ranking-item">
                                    <span class="ranking-user">
                                        <span style="font-weight: 700; color: var(--accent-color);">#<%= index + 1 %></span>
                                        <img src="<%= user.avatar %>" alt="Avatar" style="width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-color); margin-left: 4px;">
                                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100px;"><%= user.username %></span>
                                    </span>
                                    <span class="ranking-value"><%= user.value.toLocaleString() %> <%= t.songsUnit %></span>
                                </li>
                            <% }) %>
                        <% } else { %>
                            <li class="ranking-item" style="color: var(--text-muted); justify-content: center; border: none; padding-top: 25px;"><%= t.noRecords %></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE CARACTERÍSTICAS -->
        <section class="section-container">
            <div style="text-align: center; margin-bottom: 50px;">
                <h2 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 15px;"><%= t.featuresTitle %></h2>
            </div>
            <div class="cards-grid">
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-trophy"></i></div>
                    <h3><%= t.feat1Title %></h3>
                    <p><%= t.feat1Desc %></p>
                </div>
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <h3><%= t.feat2Title %></h3>
                    <p><%= t.feat2Desc %></p>
                </div>
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-music"></i></div>
                    <h3><%= t.feat3Title %></h3>
                    <p><%= t.feat3Desc %></p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE COMANDOS -->
        <section class="section-container">
            <div style="text-align: center; margin-bottom: 50px;">
                <h2 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 15px;"><%= t.commandsTitle %></h2>
            </div>
            <div class="cards-grid">
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-coins"></i></div>
                    <h3><%= t.cmd1Title %></h3>
                    <p><%= t.cmd1Desc %></p>
                </div>
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-ticket"></i></div>
                    <h3><%= t.cmd2Title %></h3>
                    <p><%= t.cmd2Desc %></p>
                </div>
                <div class="glass-card">
                    <div class="card-icon"><i class="fa-solid fa-hand-sparkles"></i></div>
                    <h3><%= t.cmd3Title %></h3>
                    <p><%= t.cmd3Desc %></p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE TESTIMONIOS -->
        <section class="section-container">
            <div style="text-align: center; margin-bottom: 50px;">
                <h2 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 15px;"><%= t.reviewsTitle %></h2>
                <p style="color: var(--text-muted); font-size: 1rem;"><%- t.reviewsDesc %></p>
            </div>
            <div class="cards-grid">
                <% if (typeof listaReviews !== 'undefined' && listaReviews.length > 0) { %>
                    <% listaReviews.slice(-4).reverse().forEach(rev => { %>
                        <div class="glass-card">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px;">
                                <img src="<%= rev.avatar %>" alt="Avatar" style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--accent-color);">
                                <div>
                                    <h4 style="margin: 0; font-size: 1.1rem; color: var(--text-color);"><%= rev.usuario %></h4>
                                    <span style="font-size: 0.8rem; color: var(--text-muted);"><%= rev.servidor %></span>
                                </div>
                            </div>
                            <div style="color: #fbbf24; margin-bottom: 10px; font-size: 0.9rem;">
                                <% for(let i = 0; i < rev.estrellas; i++) { %>★<% } %>
                            </div>
                            <p style="font-style: italic; margin: 0; color: var(--text-muted);">"<%= rev.comentario %>"</p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="glass-card" style="grid-column: 1 / -1; text-align: center;">
                        <p style="color: var(--text-muted);"><%- t.noReviews %></p>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- PREGUNTAS FRECUENTES (FAQ) -->
        <section class="section-container">
            <div style="text-align: center; margin-bottom: 50px;">
                <h2 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 15px;"><%= t.faqTitle %></h2>
            </div>
            <div class="faq-grid">
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq1Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%= t.faq1A %></div>
                </div>
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq2Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%- t.faq2A %></div>
                </div>
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq3Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%- t.faq3A %></div>
                </div>
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq4Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%- t.faq4A %></div>
                </div>
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq5Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%- t.faq5A %></div>
                </div>
                <div class="faq-item" onclick="this.classList.toggle('active')">
                    <div class="faq-question">
                        <span><%= t.faq6Q %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.9rem;"></i>
                    </div>
                    <div class="faq-answer"><%- t.faq6A %></div>
                </div>
            </div>
        </section>

        <footer>
            <div class="footer-content">
                <p style="margin: 0;"><%- t.footerRights %></p>
                <div class="footer-links">
                    <!-- LINK DE SOPORTE EN FOOTER ACTUALIZADO -->
                    <a href="https://discord.gg/xCuyb5Z33X" target="_blank"><%= t.support %></a>
                    <a href="/tos?lang=<%= userLang %>"><%= t.tos %></a>
                    <a href="/privacy?lang=<%= userLang %>"><%= t.privacy %></a>
                </div>
            </div>
        </footer>
    </div>

    <script>
        function toggleResourcesMenu() {
            const menu = document.getElementById('resourcesDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            if (userMenu) userMenu.style.display = 'none';
            if (notifMenu) notifMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            if (userMenu) userMenu.style.display = 'none';
            if (resMenu) resMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleLangMenu() {
            const menu = document.getElementById('langDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            if (userMenu) userMenu.style.display = 'none';
            if (resMenu) resMenu.style.display = 'none';
            if (notifMenu) notifMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleUserMenu() {
            const menu = document.getElementById('userDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            if (resMenu) resMenu.style.display = 'none';
            if (notifMenu) notifMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const currentTheme = html.getAttribute('data-theme');

            if (currentTheme === 'light') {
                html.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                localStorage.setItem('prem_theme', 'dark');
            } else {
                html.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                localStorage.setItem('prem_theme', 'light');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('prem_theme') || 'dark';
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            
            html.setAttribute('data-theme', savedTheme);
            if (themeIcon) {
                themeIcon.className = savedTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
        });

        window.onclick = function(event) {
            if (!event.target.closest('.user-dropdown-container') && !event.target.closest('.dropdown-container') && !event.target.closest('.notification-dropdown-container') && !event.target.closest('.lang-dropdown-container')) {
                const userMenu = document.getElementById('userDropdownMenu');
                const resMenu = document.getElementById('resourcesDropdownMenu');
                const notifMenu = document.getElementById('notificationDropdownMenu');
                const langMenu = document.getElementById('langDropdownMenu');
                if (userMenu) userMenu.style.display = 'none';
                if (resMenu) resMenu.style.display = 'none';
                if (notifMenu) notifMenu.style.display = 'none';
                if (langMenu) langMenu.style.display = 'none';
            }
        }
    </script>
</body>
</html>