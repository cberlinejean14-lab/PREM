<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>Panel Manager - PREM Bot</title>
    <style>
        body {
            background: var(--bg-gradient, #09090b);
            color: var(--text-main, #ffffff);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }
        .manager-container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }
        .manager-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        .manager-card {
            background: var(--bg-card, rgba(20, 18, 35, 0.65));
            border: 1px solid var(--border, rgba(192, 132, 252, 0.15));
            border-radius: 16px;
            padding: 30px;
            text-decoration: none;
            transition: all 0.3s ease;
            display: block;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }
        .manager-card:hover {
            border-color: var(--accent, #c084fc);
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(192, 132, 252, 0.3);
        }
    </style>
</head>
<body>

    <!-- BARRA SUPERIOR LIMPIA -->
    <header style="display: flex; justify-content: space-between; align-items: center; padding: 15px 40px; background: rgba(15, 12, 28, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border, rgba(192, 132, 252, 0.15));">
        <a href="/dashboard/manager" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text-main);">
            <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="Logo" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent, #c084fc);">
            <span style="font-weight: 800; font-size: 1.2rem;">Panel Manager Exclusivo</span>
        </a>

        <div style="display: flex; align-items: center; gap: 15px;">
            <a href="/dashboard" style="background: var(--bg-card, rgba(20, 18, 35, 0.65)); border: 1px solid var(--border); color: var(--text-main); padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-server"></i> Mis Servidores
            </a>
        </div>
    </header>

    <!-- CONTENIDO CENTRAL -->
    <div class="manager-container">
        <div style="margin-bottom: 30px;">
            <h1 style="font-size: 2.5rem; font-weight: 800; margin: 0 0 10px 0;">🛡️ Centro de Control Manager</h1>
            <p style="color: var(--text-muted, #a78bfa); font-size: 1.1rem; margin: 0;">Opciones de administración global del bot libres de menús de servidores.</p>
        </div>

        <div class="manager-cards">
            <!-- Opción 1 -->
            <a href="/dashboard/manager/notificaciones" class="manager-card">
                <div style="font-size: 28px; color: var(--accent, #c084fc); margin-bottom: 15px;"><i class="fa-solid fa-bullhorn"></i></div>
                <h3 style="color: var(--text-main); margin: 0 0 8px 0; font-size: 1.2rem;">Enviar Notificaciones</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">Publica avisos globales en tiempo real para todos los usuarios.</p>
            </a>

            <!-- Opción 2 -->
            <a href="/dashboard/manager/estadisticas" class="manager-card">
                <div style="font-size: 28px; color: var(--accent, #c084fc); margin-bottom: 15px;"><i class="fa-solid fa-chart-pie"></i></div>
                <h3 style="color: var(--text-main); margin: 0 0 8px 0; font-size: 1.2rem;">Estadísticas de Usuarios</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">Visualiza datos generales de actividad y uso de la comunidad.</p>
            </a>

            <!-- Opción 3 -->
            <a href="/dashboard/manager/sospechosos" class="manager-card">
                <div style="font-size: 28px; color: var(--accent, #c084fc); margin-bottom: 15px;"><i class="fa-solid fa-user-secret"></i></div>
                <h3 style="color: var(--text-main); margin: 0 0 8px 0; font-size: 1.2rem;">Usuarios Sospechosos</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">Revisa alertas de seguridad o comportamientos inusuales.</p>
            </a>

            <!-- Opción 4 -->
            <a href="/dashboard/manager/permisos" class="manager-card">
                <div style="font-size: 28px; color: var(--accent, #c084fc); margin-bottom: 15px;"><i class="fa-solid fa-key"></i></div>
                <h3 style="color: var(--text-main); margin: 0 0 8px 0; font-size: 1.2rem;">Gestión de Permisos</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">Añade o quita administradores autorizados para el panel de manager.</p>
            </a>
        </div>
    </div>

</body>
</html>