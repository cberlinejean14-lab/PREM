                intro: "在 PREM Bot，我们非常重视用户和社区的隐私。",
                sec1: "1. 我们收集的信息",
                sec1_desc: "我们仅收集确保机器人在您的服务器上正常运行所需的必要数据。",
                sec1_1: "Discord 数据",
                sec1_1_desc: "登录网页控制面板或与机器人互动时的用户 ID、用户名和头像。",
                sec1_2: "服务器数据",
                sec1_2_desc: "保存在我们数据库中的服务器 ID、频道和配置，用于等级、经济和管理系统。",
                sec2: "2. Cookie 的使用",
                sec2_desc: "我们仅使用技术和会话 Cookie 来保持您登录控制面板并记住您的主题和语言偏好。",
                sec3: "3. 信息共享",
                sec3_desc: "在任何情况下，我们都不会向第三方出售、交易或转让您的个人信息。",
                sec4: "4. 安全与支付",
                sec4_desc: "与升级或高级方案相关的所有交易均通过安全的外部支付网关处理。我们不会在服务器上存储银行卡数据。",
                sec5: "5. 政策变更",
                sec5_desc: "我们保留随时更新本隐私政策的权利。任何重大修改都将通过我们的官方渠道进行沟通。",
                sec6: "6. 数据删除",
                sec6_desc: "您可以直接在我们的 Discord 支持服务器中与我们联系，请求完全删除您的服务器或帐户数据。",
                acceptQuestion: "您是否接受我们的隐私政策条款？",
                acceptSubtext: "接受条款后，您的个人资料将获得一枚徽章。要查看它，您必须使用 /profile 命令",
                acceptBtn: "接受",
                rejectBtn: "拒绝",
                acceptedText: "感谢您接受我们的隐私政策！",
                rejectedText: "您已拒绝该政策。"
            }
        };

        const t = privacyDict[userLang] || privacyDict['es'];
    %>

    <div id="progress-bar"></div>

    <nav>
        <a href="/?lang=<%= userLang %>" class="nav-left">
            <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="Bot Avatar" class="bot-avatar">
            <span class="bot-name">PREM</span>
        </a>

        <div style="display: flex; align-items: center; gap: 12px;">
            
            <!-- CAMPANA DE NOTIFICACIONES -->
            <div class="notification-container" style="position: relative; display: inline-block; z-index: 10000;">
                <button onclick="toggleNotificationMenu()" id="notificationBtn" style="background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(10px); transition: all 0.3s ease; position: relative;" title="Notificaciones">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                    </svg>
                    <span style="position: absolute; top: 7px; right: 8px; width: 8px; height: 8px; background-color: var(--accent-color); border-radius: 50%; box-shadow: 0 0 8px var(--accent-color);"></span>
                </button>
                
                <div id="notificationMenu" style="display: none; position: absolute; right: 0; top: 115%; width: 280px; background: var(--nav-bg); backdrop-filter: blur(20px); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); padding: 12px; z-index: 99999; text-align: left;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-bottom: 8px;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text-color);">🔔 Notificaciones</span>
                        <span style="font-size: 11px; color: var(--text-muted); cursor: pointer;" onclick="markAsRead()">Marcar leídas</span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="background: var(--card-bg); padding: 10px; border-radius: 10px; border: 1px solid var(--border-color);">
                            <div style="font-size: 12px; font-weight: 700; color: var(--accent-color);">🚀 Actualización PREM</div>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Nuevas opciones de personalización ya disponibles.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selector de Idioma -->
            <div class="lang-dropdown" style="position: relative; display: inline-block; z-index: 1000;">
                <button onclick="toggleLangMenu()" class="lang-btn">
                    <% 
                        let flag = '🇪🇸'; let langName = 'Español';
                        if (userLang === 'en') { flag = '🇺🇸'; langName = 'English'; }
                        else if (userLang === 'pt') { flag = '🇧🇷'; langName = 'Português'; }
                        else if (userLang === 'fr') { flag = '🇫🇷'; langName = 'Français'; }
                        else if (userLang === 'hi') { flag = '🇮🇳'; langName = 'हिन्दी'; }
                        else if (userLang === 'ar') { flag = '🇸🇦'; langName = 'العربية'; }
                        else if (userLang === 'zh') { flag = '🇨🇳'; langName = '中文'; }
                    %>
                    <span><%= flag %></span>
                    <span><%= langName %></span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
                </button>
                <div id="langMenu" style="display: none; position: absolute; right: 0; top: 120%; background: var(--nav-bg); backdrop-filter: blur(20px); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); overflow: hidden; min-width: 160px;">
                    <a href="/privacy?lang=es" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇪🇸</span> Español</a>
                    <a href="/privacy?lang=en" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇺🇸</span> English</a>
                    <a href="/privacy?lang=pt" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇧🇷</span> Português</a>
                    <a href="/privacy?lang=fr" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇫🇷</span> Français</a>
                    <a href="/privacy?lang=hi" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇮🇳</span> हिन्दी</a>
                    <a href="/privacy?lang=ar" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇸🇦</span> العربية</a>
                    <a href="/privacy?lang=zh" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇨🇳</span> 中文</a>
                </div>
            </div>

            <!-- Botón Tema -->
            <button class="theme-btn" onclick="toggleTheme()" title="Cambiar tema">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>

            <!-- Perfil / Login -->
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-dropdown" style="position: relative; display: inline-block;">
                    <button onclick="toggleUserMenu()" class="lang-btn" style="padding: 4px 12px 4px 5px;">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" style="width: 30px; height: 30px; border-radius: 50%; object-fit: cover;">
                        <span style="max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= user.username %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
                    </button>
                    <div id="userMenu" style="display: none; position: absolute; right: 0; top: 120%; background: var(--nav-bg); backdrop-filter: blur(20px); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); overflow: hidden; min-width: 150px;">
                        <a href="/dashboard?lang=<%= userLang %>" style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><i class="fa-solid fa-sliders"></i> Dashboard</a>
                        <a href="/logout" style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; color: #f87171; text-decoration: none; font-size: 0.85rem;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>
            <% } else { %>
                <a href="/auth/discord" class="login-btn"><i class="fa-brands fa-discord"></i> Login</a>
            <% } %>
        </div>
    </nav>

    <div class="unique-container">
        <div class="hero-legal">
            <h1><%= t.heading %></h1>
            <span><i class="fa-regular fa-clock"></i> <%= t.updated %></span>
        </div>

        <div class="legal-card">
            <p style="font-size: 1.1rem; border-left: 3px solid var(--accent-color); padding-left: 15px; margin-bottom: 35px;"><%= t.intro %></p>

            <h2><i class="fa-solid fa-shield-halved"></i> <%= t.sec1 %></h2>
            <p><%= t.sec1_desc %></p>
            
            <h3><%= t.sec1_1 %></h3>
            <p><%= t.sec1_1_desc %></p>

            <h3><%= t.sec1_2 %></h3>
            <p><%= t.sec1_2_desc %></p>

            <h2><i class="fa-solid fa-cookie-bite"></i> <%= t.sec2 %></h2>
            <p><%= t.sec2_desc %></p>

            <h2><i class="fa-solid fa-handshake-angle"></i> <%= t.sec3 %></h2>
            <p><%= t.sec3_desc %></p>

            <h2><i class="fa-solid fa-credit-card"></i> <%= t.sec4 %></h2>
            <div class="secure-badge-box">
                <i class="fa-solid fa-lock"></i>
                <p style="margin: 0;"><%= t.sec4_desc %></p>
            </div>

            <h2><i class="fa-solid fa-triangle-exclamation"></i> <%= t.sec5 %></h2>
            <p><%= t.sec5_desc %></p>

            <h2><i class="fa-solid fa-user-slash"></i> <%= t.sec6 %></h2>
            <p><%= t.sec6_desc %></p>

            <!-- SECCIÓN DE PREGUNTA, TEXTO PEQUEÑO Y BOTONES -->
            <div class="consent-section">
                <h3><%= t.acceptQuestion %></h3>
                <div class="consent-subtext"><%= t.acceptSubtext %></div>
                <div class="consent-buttons">
                    <button class="btn-accept" onclick="handleConsent(true)">
                        <i class="fa-solid fa-check"></i> <%= t.acceptBtn %>
                    </button>
                    <button class="btn-reject" onclick="handleConsent(false)">
                        <i class="fa-solid fa-xmark"></i> <%= t.rejectBtn %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- NOTIFICACIÓN FLOTANTE (TOAST) -->
    <div id="toastNotification">
        <i id="toastIcon" class="fa-solid fa-circle-check" style="font-size: 1.2rem;"></i>
        <span id="toastText"></span>
    </div>

    <footer>
        <p>&copy; 2026 PREM Bot. All rights reserved.</p>
    </footer>

    <script>
        window.addEventListener('scroll', () => {
            const winScroll = document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            document.getElementById('progress-bar').style.width = scrolled + '%';
        });

        let toastTimer;
        function handleConsent(isAccepted) {
            const toast = document.getElementById('toastNotification');
            const icon = document.getElementById('toastIcon');
            const text = document.getElementById('toastText');

            if (isAccepted) {
                icon.className = 'fa-solid fa-circle-check';
                icon.style.color = '#4ade80';
                text.innerText = "<%= t.acceptedText %>";
                localStorage.setItem('prem_privacy_accepted', 'true');

                fetch('/api/accept-privacy', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ accepted: true })
                })
                .then(response => response.json())
                .then(data => {
                    console.log("Respuesta del servidor:", data);
                })
                .catch(error => {
                    console.error("Error al asignar la insignia:", error);
                });

            } else {
                icon.className = 'fa-solid fa-triangle-exclamation';
                icon.style.color = '#f87171';
                text.innerText = "<%= t.rejectedText %>";
                localStorage.setItem('prem_privacy_accepted', 'false');
            }

            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('show');
            }, 4000);
        }

        function toggleLangMenu() {
            const menu = document.getElementById('langMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationMenu');
            if (menu) {
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            }
        }

        function markAsRead() {
            const badge = document.querySelector('#notificationBtn span');
            if (badge) badge.style.display = 'none';
        }

        function toggleUserMenu() {
            const userMenu = document.getElementById('userMenu');
            if (userMenu) {
                userMenu.style.display = userMenu.style.display === 'block' ? 'none' : 'block';
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const currentTheme = html.getAttribute('data-theme');

            if (currentTheme === 'light') {
                html.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                localStorage.setItem('prem_theme', 'dark');
            } else {
                html.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                localStorage.setItem('prem_theme', 'light');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('prem_theme') || 'dark';
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            
            html.setAttribute('data-theme', savedTheme);
            if (savedTheme === 'light') {
                themeIcon.className = 'fa-solid fa-sun';
            } else {
                themeIcon.className = 'fa-solid fa-moon';
            }
        });

        window.onclick = function(event) {
            if (!event.target.closest('.notification-container')) {
                const menu = document.getElementById('notificationMenu');
                if (menu) menu.style.display = 'none';
            }
            if (!event.target.closest('.lang-dropdown')) {
                const menu = document.getElementById('langMenu');
                if (menu) menu.style.display = 'none';
            }
            if (!event.target.closest('.user-dropdown')) {
                const userMenu = document.getElementById('userMenu');
                if (userMenu) userMenu.style.display = 'none';
            }
        }
    </script>
</body>
</html>