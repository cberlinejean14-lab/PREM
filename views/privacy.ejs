<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PREM - Privacy Policy</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-gradient: #070514;
            --card-bg: rgba(18, 14, 38, 0.7);
            --text-color: #f3e8ff;
            --text-muted: #c084fc;
            --accent-color: #a855f7;
            --accent-glow: rgba(168, 85, 247, 0.35);
            --border-color: rgba(168, 85, 247, 0.25);
            --nav-bg: rgba(10, 7, 24, 0.85);
            --box-highlight: rgba(168, 85, 247, 0.08);
        }

        [data-theme="light"] {
            --bg-gradient: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.85);
            --text-color: #1e1b4b;
            --text-muted: #6b21a8;
            --accent-color: #9333ea;
            --accent-glow: rgba(147, 51, 234, 0.25);
            --border-color: rgba(147, 51, 234, 0.2);
            --nav-bg: rgba(255, 255, 255, 0.9);
            --box-highlight: rgba(147, 51, 234, 0.04);
        }

        body {
            background: var(--bg-gradient);
            background-image: 
                radial-gradient(at 10% 20%, rgba(126, 34, 206, 0.15) 0px, transparent 50%),
                radial-gradient(at 90% 80%, rgba(76, 29, 149, 0.15) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--text-color);
            font-family: 'Inter', system-ui, sans-serif;
            margin: 0; padding: 0; min-height: 100vh;
            display: flex; flex-direction: column; justify-content: space-between;
        }

        #progress-bar {
            position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(90deg, #c084fc, #ec4899);
            width: 0%; z-index: 2000; transition: width 0.1s ease;
        }

        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 18px 40px; background-color: var(--nav-bg);
            backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color);
            position: sticky; top: 0; z-index: 1000;
        }

        .nav-left {
            display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text-color);
        }

        .bot-avatar {
            width: 38px; height: 38px; border-radius: 50%; object-fit: cover;
            border: 2px solid var(--accent-color); box-shadow: 0 0 12px var(--accent-glow);
        }

        .bot-name {
            font-weight: 800; font-size: 1.3rem; letter-spacing: 0.5px;
            background: linear-gradient(45deg, #fff, var(--accent-color));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .unique-container {
            max-width: 900px; width: 100%; margin: 50px auto; padding: 0 20px;
            box-sizing: border-box;
        }

        .hero-legal {
            text-align: center; margin-bottom: 45px;
        }

        .hero-legal h1 {
            font-size: 2.8rem; margin: 0 0 10px 0; font-weight: 900;
            background: linear-gradient(135deg, #fff 30%, var(--accent-color) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .hero-legal span {
            color: var(--text-muted); font-size: 0.95rem; font-weight: 500;
        }

        .legal-card {
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 24px; padding: 50px; backdrop-filter: blur(25px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4); position: relative; overflow: hidden;
        }

        .legal-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px;
            background: linear-gradient(90deg, var(--accent-color), #ec4899);
        }

        .legal-card h2 {
            font-size: 1.35rem; margin-top: 40px; color: var(--accent-color);
            display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;
        }

        .legal-card h3 {
            font-size: 1.05rem; margin-top: 25px; color: var(--text-color); font-weight: 700;
        }

        .legal-card p, .legal-card li {
            color: var(--text-muted); line-height: 1.8; font-size: 1rem;
        }

        .secure-badge-box {
            background: var(--box-highlight); border: 1px dashed var(--accent-color);
            border-radius: 16px; padding: 25px; margin-top: 25px; display: flex; gap: 20px; align-items: center;
        }

        .secure-badge-box i {
            font-size: 2.2rem; color: var(--accent-color); flex-shrink: 0;
        }

        /* Sección de Consentimiento */
        .consent-section {
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid var(--border-color);
            text-align: center;
        }

        .consent-section h3 {
            font-size: 1.25rem;
            color: var(--text-color);
            margin-bottom: 8px;
        }

        .consent-subtext {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 20px;
            opacity: 0.85;
        }

        .consent-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-accept {
            background: linear-gradient(135deg, #a855f7, #9333ea);
            color: #ffffff;
            border: none;
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px var(--accent-glow);
            transition: all 0.3s ease;
        }

        .btn-accept:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        .btn-reject {
            background: var(--card-bg);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-reject:hover {
            border-color: #ef4444;
            color: #ef4444;
            transform: translateY(-2px);
        }

        /* Notificación Flotante (Toast) */
        #toastNotification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: rgba(20, 18, 35, 0.95);
            border: 1px solid var(--border-color);
            padding: 16px 24px;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            font-weight: 600;
            z-index: 9999;
            transform: translateY(120px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        #toastNotification.show {
            transform: translateY(0);
            opacity: 1;
        }

        .login-btn, .theme-btn, .lang-btn {
            background: var(--card-bg); border: 1px solid var(--border-color);
            color: var(--text-color); padding: 8px 16px; border-radius: 20px;
            font-weight: 600; text-decoration: none; display: flex; align-items: center;
            gap: 8px; backdrop-filter: blur(10px); transition: all 0.3s ease; font-size: 0.9rem; cursor: pointer;
        }

        .login-btn:hover, .theme-btn:hover, .lang-btn:hover {
            border-color: var(--accent-color); box-shadow: 0 0 15px var(--accent-glow); transform: translateY(-1px);
        }

        .theme-btn { width: 38px; height: 38px; border-radius: 50%; justify-content: center; padding: 0; }

        footer {
            text-align: center; padding: 35px; color: var(--text-muted);
            background: var(--nav-bg); border-top: 1px solid var(--border-color); margin-top: 80px;
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .legal-card { padding: 25px; }
            .hero-legal h1 { font-size: 2.2rem; }
            nav { padding: 15px 20px; }
            .secure-badge-box { flex-direction: column; text-align: center; }
            #toastNotification { right: 15px; left: 15px; bottom: 20px; }
        }
    </style>
</head>
