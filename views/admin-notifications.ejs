<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Enviar Notificación - Creadora</title>
    <style>
        .textarea-wrapper {
            position: relative;
            width: 100%;
        }
        .emoji-btn {
            position: absolute;
            bottom: 12px;
            right: 12px;
            background: rgba(184, 117, 248, 0.15);
            border: 1px solid var(--border);
            color: var(--text-main);
            width: 32px;
            height: 32px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: all 0.2s;
            z-index: 5;
            margin: 0 !important;
            padding: 0 !important;
        }
        .emoji-btn:hover {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(184, 117, 248, 0.5);
        }
        .emoji-picker-dropdown {
            display: none;
            position: absolute;
            bottom: 50px;
            right: 0;
            background: var(--bg-sidebar);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            padding: 12px;
            z-index: 10;
            width: 250px;
            max-height: 200px;
            overflow-y: auto;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
            backdrop-filter: blur(15px);
        }
        .emoji-picker-dropdown.show {
            display: grid;
        }
        .emoji-option {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            text-align: center;
            font-size: 16px;
            padding: 6px 0;
            cursor: pointer;
            transition: transform 0.1s, background 0.1s;
        }
        .emoji-option:hover {
            transform: scale(1.15);
            background: var(--hover-sidebar);
            border-color: var(--accent);
        }
        .history-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background: var(--bg-card);
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border);
        }
        .history-table th, .history-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            color: var(--text-main);
        }
        .history-table th {
            background: rgba(184, 117, 248, 0.1);
            font-weight: 700;
        }
        .history-table tr:last-child td {
            border-bottom: none;
        }
        .btn-delete-item {
            background: #ef4444;
            color: white;
            border: none;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            transition: opacity 0.2s;
        }
        .btn-delete-item:hover {
            opacity: 0.8;
        }

        #confirmToastOverlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            z-index: 99998;
            animation: fadeIn 0.2s ease;
        }
        #confirmToast {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #181028, #2a1b4e);
            border: 1px solid rgba(184, 117, 248, 0.4);
            border-radius: 18px;
            box-shadow: 0 0 35px rgba(184, 117, 248, 0.35), 0 15px 30px rgba(0,0,0,0.7);
            padding: 24px 30px;
            z-index: 99999;
            text-align: center;
            width: 420px;
            animation: scaleUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes scaleUp {
            from { transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
            to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
        }
        .toast-title {
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 20px;
            text-shadow: 0 0 10px rgba(184, 117, 248, 0.5);
        }
        .toast-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
        }
        .toast-btn-yes {
            background: linear-gradient(135deg, #b875f8, #9333ea);
            color: white;
            border: none;
            padding: 8px 24px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(147, 51, 234, 0.6);
            transition: all 0.2s;
        }
        .toast-btn-yes:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(184, 117, 248, 0.9);
        }
        .toast-btn-no {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-main);
            border: 1px solid rgba(184, 117, 248, 0.2);
            padding: 8px 24px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .toast-btn-no:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(184, 117, 248, 0.5);
        }
    </style>
</head>
<body>
    <%- include('partials/sidebar') %>

    <div class="main-content" style="margin-top: 60px;">
        <h1>📢 Enviar Notificación Global</h1>
        <p class="subtitle">Gestiona y envía avisos en tiempo real a todos los usuarios.</p>

        <!-- FORMULARIO DE ENVÍO BLINDADO -->
        <div class="card" style="max-width: 700px; margin-bottom: 30px;">
            <form action="/admin/enviar-notificacion" method="POST" id="notificationForm">
                <label for="title">Título de la Notificación</label>
                <input type="text" id="title" name="title" placeholder="Ej: 🚀 ¡Nueva Actualización!" required>

                <label for="message">Mensaje</label>
                <div class="textarea-wrapper">
                    <textarea id="message" name="message" rows="4" placeholder="Escribe el contenido del aviso..." required style="padding-right: 45px;"></textarea>
                    
                    <button type="button" class="emoji-btn" id="emojiBtn" title="Insertar emojis y iconos">
                        <i class="fa-solid fa-face-smile"></i>
                    </button>

                    <div id="emojiPicker" class="emoji-picker-dropdown">
                        <div class="emoji-option" onclick="insertEmoji('🚀')">🚀</div>
                        <div class="emoji-option" onclick="insertEmoji('⭐')">⭐</div>
                        <div class="emoji-option" onclick="insertEmoji('🔔')">🔔</div>
                        <div class="emoji-option" onclick="insertEmoji('✅')">✅</div>
                        <div class="emoji-option" onclick="insertEmoji('❌')">❌</div>
                        <div class="emoji-option" onclick="insertEmoji('⚠️')">⚠️</div>
                        <div class="emoji-option" onclick="insertEmoji('💡')">💡</div>
                        <div class="emoji-option" onclick="insertEmoji('🎉')">🎉</div>
                        <div class="emoji-option" onclick="insertEmoji('🔥')">🔥</div>
                        <div class="emoji-option" onclick="insertEmoji('🛠️')">🛠️</div>
                        <div class="emoji-option" onclick="insertEmoji('💬')">💬</div>
                        <div class="emoji-option" onclick="insertEmoji('📌')">📌</div>
                        <div class="emoji-option" onclick="insertEmoji('✨')">✨</div>
                        <div class="emoji-option" onclick="insertEmoji('👑')">👑</div>
                        <div class="emoji-option" onclick="insertEmoji('🤖')">🤖</div>
                        <div class="emoji-option" onclick="insertEmoji('💖')">💖</div>
                        <div class="emoji-option" onclick="insertEmoji('💎')">💎</div>
                        <div class="emoji-option" onclick="insertEmoji('🛡️')">🛡️</div>
                        <div class="emoji-option" onclick="insertEmoji('⚙️')">⚙️</div>
                        <div class="emoji-option" onclick="insertEmoji('📢')">📢</div>
                    </div>
                </div>

                <button type="submit" style="margin-top: 20px;">Enviar a todos</button>
            </form>
            <div id="statusMsg" style="margin-top: 15px; font-weight: bold;"></div>
        </div>

        <!-- REGISTRO / HISTORIAL DE NOTIFICACIONES -->
        <div class="card" style="max-width: 700px;">
            <h3>📋 Registro de Notificaciones Enviadas</h3>
            <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 15px;">Aquí puedes ver el historial y eliminar cualquier aviso enviado por equivocación.</p>
            
            <div style="overflow-x: auto;">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Título</th>
                            <th>Mensaje</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="historyBody">
                        <% if (typeof historial !== 'undefined' && historial.length > 0) { %>
                            <% historial.forEach(item => { %>
                                <tr id="row-<%= item.id %>">
                                    <td style="white-space: nowrap; color: var(--text-muted);"><%= item.date %></td>
                                    <td style="font-weight: 600;"><%= item.title %></td>
                                    <td><%= item.message %></td>
                                    <td>
                                        <button class="btn-delete-item" onclick="pedirConfirmacion('<%= item.id %>')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr id="emptyRow">
                                <td colspan="4" style="text-align: center; color: var(--text-muted);">No hay notificaciones registradas.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL CENTRADO -->
    <div id="confirmToastOverlay" onclick="cerrarConfirmacion()"></div>
    <div id="confirmToast">
        <div class="toast-title">¿Estás segura de eliminar este aviso?</div>
        <div class="toast-buttons">
            <button class="toast-btn-no" onclick="cerrarConfirmacion()">NO</button>
            <button class="toast-btn-yes" id="confirmYesBtn">SÍ</button>
        </div>
    </div>

    <script>
        const emojiBtn = document.getElementById('emojiBtn');
        const emojiPicker = document.getElementById('emojiPicker');
        const messageInput = document.getElementById('message');

        emojiBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            emojiPicker.classList.toggle('show');
        });

        function insertEmoji(emoji) {
            const start = messageInput.selectionStart;
            const end = messageInput.selectionEnd;
            const text = messageInput.value;
            messageInput.value = text.substring(0, start) + emoji + text.substring(end);
            messageInput.focus();
            messageInput.selectionStart = messageInput.selectionEnd = start + emoji.length;
            emojiPicker.classList.remove('show');
        }

        window.addEventListener('click', (e) => {
            if (!emojiBtn.contains(e.target) && !emojiPicker.contains(e.target)) {
                emojiPicker.classList.remove('show');
            }
        });

        document.getElementById('notificationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const title = document.getElementById('title').value;
            const message = document.getElementById('message').value;
            const statusMsg = document.getElementById('statusMsg');

            try {
                const response = await fetch('/admin/enviar-notificacion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, message })
                });

                const result = await response.json();
                if (result.success) {
                    statusMsg.style.color = '#22c55e';
                    statusMsg.textContent = '✅ ¡Notificación enviada con éxito!';
                    document.getElementById('notificationForm').reset();
                    setTimeout(() => {
                        window.location.href = '/dashboard/admin/notificaciones';
                    }, 600);
                } else {
                    statusMsg.style.color = '#ef4444';
                    statusMsg.textContent = '❌ ' + (result.message || 'Error al enviar.');
                }
            } catch (err) {
                console.error(err);
                statusMsg.style.color = '#ef4444';
                statusMsg.textContent = '❌ Error de conexión.';
            }
        });

        let idNotificationToDelete = null;

        function pedirConfirmacion(id) {
            idNotificationToDelete = id;
            document.getElementById('confirmToastOverlay').style.display = 'block';
            document.getElementById('confirmToast').style.display = 'block';
        }

        function cerrarConfirmacion() {
            idNotificationToDelete = null;
            document.getElementById('confirmToastOverlay').style.display = 'none';
            document.getElementById('confirmToast').style.display = 'none';
        }

        document.getElementById('confirmYesBtn').addEventListener('click', async () => {
            if (!idNotificationToDelete) return;
            const id = idNotificationToDelete;
            cerrarConfirmacion();

            try {
                const response = await fetch('/admin/eliminar-notificacion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });

                const result = await response.json();
                if (result.success) {
                    const row = document.getElementById(`row-${id}`);
                    if (row) row.remove();
                } else {
                    alert('No se pudo eliminar el aviso.');
                }
            } catch (err) {
                console.error(err);
                alert('Error de conexión con el servidor.');
            }
        });
    </script>
</body>
</html>