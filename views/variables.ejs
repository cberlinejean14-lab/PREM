                </div>
            <% } else { %>
                <a href="/auth/discord" class="login-btn"><i class="fa-brands fa-discord"></i> Login</a>
            <% } %>
        </div>
    </nav>

    <div class="main-content">
        <div class="container">
            <a href="/?lang=<%= userLang %>" class="back-link"><i class="fa-solid fa-arrow-left"></i> <%= userLang === 'en' ? 'Back to home' : 'Volver al inicio' %></a>
            <h1><%= userLang === 'en' ? 'Available Variables' : 'Variables Disponibles' %></h1>
            <p><%= userLang === 'en' ? 'Click on any variable to copy it automatically to your clipboard:' : 'Haz clic en cualquier variable para copiarla automáticamente al portapapeles:' %></p>
            
            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="<%= userLang === 'en' ? 'Search variable or description...' : 'Buscar variable o descripción...' %>" onkeyup="filterVariables()">
            </div>

            <div class="variable-list" id="variableList">
                <div class="variable-box" data-name="mencionar al usuario user mention">
                    <span><%= userLang === 'en' ? 'Mention user' : 'Mencionar al usuario' %></span>
                    <code onclick="copyToClipboard('{user}')">{user}</code>
                </div>
                <div class="variable-box" data-name="nombre del usuario username">
                    <span><%= userLang === 'en' ? 'Username' : 'Nombre de usuario' %></span>
                    <code onclick="copyToClipboard('{username}')">{username}</code>
                </div>
                <div class="variable-box" data-name="id del usuario user id">
                    <span><%= userLang === 'en' ? 'User ID' : 'ID del usuario' %></span>
                    <code onclick="copyToClipboard('{user_id}')">{user_id}</code>
                </div>
                <div class="variable-box" data-name="nombre del servidor server name">
                    <span><%= userLang === 'en' ? 'Server name' : 'Nombre del servidor' %></span>
                    <code onclick="copyToClipboard('{server}')">{server}</code>
                </div>
                <div class="variable-box" data-name="id del servidor server id">
                    <span><%= userLang === 'en' ? 'Server ID' : 'ID del servidor' %></span>
                    <code onclick="copyToClipboard('{server_id}')">{server_id}</code>
                </div>
                <div class="variable-box" data-name="cantidad de miembros server members count">
                    <span><%= userLang === 'en' ? 'Member count' : 'Cantidad de miembros' %></span>
                    <code onclick="copyToClipboard('{server_members}')">{server_members}</code>
                </div>
                <div class="variable-box" data-name="mencionar canal channel mention">
                    <span><%= userLang === 'en' ? 'Channel mention' : 'Mencionar canal' %></span>
                    <code onclick="copyToClipboard('{channel}')">{channel}</code>
                </div>
                <div class="variable-box" data-name="nombre del canal channel name">
                    <span><%= userLang === 'en' ? 'Channel name' : 'Nombre del canal' %></span>
                    <code onclick="copyToClipboard('{channel_name}')">{channel_name}</code>
                </div>
            </div>
        </div>
    </div>

    <div id="copyToast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toastText"><%= userLang === 'en' ? 'Variable copied!' : '¡Variable copiada!' %></span>
    </div>

    <footer>
        <p style="margin: 0;">&copy; 2026 PREM Bot. <%= userLang === 'en' ? 'All rights reserved.' : 'Todos los derechos reservados.' %></p>
    </footer>

    <script>
        function markAsRead() {
            const badge = document.getElementById('notifBadge');
            if (badge) {
                badge.style.display = 'none';
            }
        }

        function toggleResourcesMenu() {
            const menu = document.getElementById('resourcesDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            if (notifMenu) notifMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (userMenu) userMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            if (resMenu) resMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (userMenu) userMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleLangMenu() {
            const menu = document.getElementById('langDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            if (resMenu) resMenu.style.display = 'none';
            if (notifMenu) notifMenu.style.display = 'none';
            if (userMenu) userMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleUserMenu() {
            const menu = document.getElementById('userDropdownMenu');
            const resMenu = document.getElementById('resourcesDropdownMenu');
            const notifMenu = document.getElementById('notificationDropdownMenu');
            const langMenu = document.getElementById('langDropdownMenu');
            if (resMenu) resMenu.style.display = 'none';
            if (notifMenu) notifMenu.style.display = 'none';
            if (langMenu) langMenu.style.display = 'none';
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        window.onclick = function(event) {
            if (!event.target.closest('.resources-dropdown-container') && !event.target.closest('.user-dropdown-container') && !event.target.closest('.lang-dropdown-container') && !event.target.closest('.notification-dropdown-container')) {
                const resMenu = document.getElementById('resourcesDropdownMenu');
                const userMenu = document.getElementById('userDropdownMenu');
                const langMenu = document.getElementById('langDropdownMenu');
                const notifMenu = document.getElementById('notificationDropdownMenu');
                if (resMenu) resMenu.style.display = 'none';
                if (userMenu) userMenu.style.display = 'none';
                if (langMenu) langMenu.style.display = 'none';
                if (notifMenu) notifMenu.style.display = 'none';
            }
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.getElementById('copyToast');
                const toastText = document.getElementById('toastText');
                toastText.innerText = `<%= userLang === 'en' ? 'Copied: ' : '¡Copiado: ' %>` + text + `<%= userLang === 'en' ? '' : '!' %>`;
                toast.classList.add('show');
                
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 2000);
            }).catch(err => {
                console.error('Error al copiar: ', err);
            });
        }

        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const currentTheme = html.getAttribute('data-theme');

            if (currentTheme === 'light') {
                html.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                localStorage.setItem('prem_theme', 'dark');
            } else {
                html.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                localStorage.setItem('prem_theme', 'light');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('prem_theme') || 'dark';
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            html.setAttribute('data-theme', savedTheme);
            if (themeIcon) {
                themeIcon.className = savedTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
        });

        function filterVariables() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let items = document.getElementsByClassName('variable-box');

            for (let i = 0; i < items.length; i++) {
                let text = items[i].getAttribute('data-name').toLowerCase();
                let spanText = items[i].getElementsByTagName('span')[0].innerText.toLowerCase();
                let codeText = items[i].getElementsByTagName('code')[0].innerText.toLowerCase();

                if (text.includes(input) || spanText.includes(input) || codeText.includes(input)) {
                    items[i].style.display = "flex";
                } else {
                    items[i].style.display = "none";
                }
            }
        }
    </script>
</body>
</html>