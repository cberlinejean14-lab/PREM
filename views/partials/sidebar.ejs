        <% if (typeof user !== 'undefined' && user && user.id === '931545363565908041') { %>
            <div style="font-size: 10px; color: var(--accent); font-weight: bold; margin: 15px 0 6px 10px; text-transform: uppercase;">🛡️ Manager Panel</div>
            <a href="/dashboard/manager/notificaciones" class="menu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'manager-notificaciones' ? 'active' : '' %>" style="padding: 10px 14px; color: var(--text-muted); text-decoration: none; border-radius: 10px; margin-bottom: 6px; display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 14px;">📢 Enviar Notificaciones</a>
            <a href="/dashboard/manager/estadisticas" class="menu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'manager-estadisticas' ? 'active' : '' %>" style="padding: 10px 14px; color: var(--text-muted); text-decoration: none; border-radius: 10px; margin-bottom: 6px; display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 14px;">📊 Estadísticas de Usuarios</a>
            <a href="/dashboard/manager/sospechosos" class="menu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'manager-sospechosos' ? 'active' : '' %>" style="padding: 10px 14px; color: var(--text-muted); text-decoration: none; border-radius: 10px; margin-bottom: 6px; display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 14px;">🕵️‍♂️ Usuarios Sospechosos</a>
        <% } %>
    </sidebar>

<!-- SCRIPT PARA EL MENÚ, TEMAS Y SOCKET.IO DE NOTIFICACIONES -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();

    socket.on('borrar-notificacion', (data) => {
        if (data && data.id) {
            const item = document.getElementById(`notif-item-${data.id}`);
            if (item) item.remove();
        } else {
            location.reload();
        }
    });

    socket.on('nueva-notificacion', (data) => {
        const notifList = document.getElementById('notificationList');
        if (notifList) {
            const defaultNotif = document.getElementById('defaultNotif');
            if (defaultNotif) defaultNotif.remove();

            const newDiv = document.createElement('div');
            newDiv.style.cssText = "background: var(--bg-card); padding: 10px; border-radius: 10px; border: 1px solid var(--border);";
            newDiv.innerHTML = `
                <div style="font-size: 12px; font-weight: 700; color: var(--accent);">${data.title}</div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">${data.message}</div>
                <div style="font-size: 9px; color: var(--text-muted); margin-top: 4px; text-align: right;">Justo ahora</div>
            `;
            notifList.prepend(newDiv);

            const badge = document.querySelector('#notificationBtn span');
            if (badge) badge.style.display = 'block';
        }
    });

    function toggleUserMenu() {
        const menu = document.getElementById('userDropdownMenu');
        if (menu) {
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
    }

    function toggleNotificationMenu() {
        const menu = document.getElementById('notificationMenu');
        if (menu) {
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
    }

    function markAsRead() {
        const badge = document.querySelector('#notificationBtn span');
        if (badge) badge.style.display = 'none';
        localStorage.setItem('prem_notifications_read', 'true_' + Date.now());
    }

    function toggleTheme() {
        const html = document.documentElement;
        const themeIcon = document.getElementById('themeIcon');
        const currentTheme = html.getAttribute('data-theme');

        if (currentTheme === 'light') {
            html.setAttribute('data-theme', 'dark');
            if (themeIcon) themeIcon.className = 'fa-solid fa-moon';
            localStorage.setItem('prem_theme', 'dark');
        } else {
            html.setAttribute('data-theme', 'light');
            if (themeIcon) themeIcon.className = 'fa-solid fa-sun';
            localStorage.setItem('prem_theme', 'light');
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('prem_theme') || 'dark';
        const html = document.documentElement;
        const themeIcon = document.getElementById('themeIcon');
        
        html.setAttribute('data-theme', savedTheme);
        if (themeIcon) {
            themeIcon.className = savedTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        }

        if (localStorage.getItem('prem_notifications_read')) {
            const badge = document.querySelector('#notificationBtn span');
            if (badge) badge.style.display = 'none';
        }
    });

    window.addEventListener('click', function(e) {
        const notifContainer = document.querySelector('.notification-container');
        const notifMenu = document.getElementById('notificationMenu');
        if (notifContainer && notifMenu && !notifContainer.contains(e.target)) {
            notifMenu.style.display = 'none';
        }

        const container = document.querySelector('.user-dropdown-container');
        const menu = document.getElementById('userDropdownMenu');
        if (container && menu && !container.contains(e.target)) {
            menu.style.display = 'none';
        }
    });
</script>