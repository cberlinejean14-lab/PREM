<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comandos Personalizados - PREM Bot</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0f0f13;
            --bg-card: #18181f;
            --bg-sidebar: #131318;
            --border: #272733;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --gold-primary: #facc15;
            --gold-gradient: linear-gradient(135deg, #ffffff, #fef08a, #facc15);
            --nav-bg: rgba(19, 19, 24, 0.85);
        }
        [data-theme="light"] {
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --bg-sidebar: #f1f5f9;
            --border: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --nav-bg: rgba(241, 245, 249, 0.85);
        }
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .main-content {
            flex-grow: 1;
            padding: 40px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header-section h1 {
            font-size: 24px;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header-section h1 i {
            color: #facc15;
            text-shadow: 0 0 12px rgba(250, 204, 21, 0.6);
        }
        
        /* Controles Superiores Derecha (Idioma, Campana, Tema) */
        .top-right-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .lang-btn, .theme-btn, .login-btn {
            background: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .lang-btn:hover, .theme-btn:hover {
            border-color: #facc15;
            box-shadow: 0 0 15px rgba(250, 204, 21, 0.25);
        }

        .theme-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            justify-content: center;
            padding: 0;
        }

        .badge-exclusive-gold {
            background: var(--gold-gradient);
            color: #713f12;
            font-size: 11px;
            padding: 5px 12px;
            border-radius: 8px;
            font-weight: 800;
            letter-spacing: 0.5px;
            box-shadow: 0 0 15px rgba(253, 224, 71, 0.5);
            border: 1px solid rgba(250, 204, 21, 0.6);
            text-transform: uppercase;
        }
        .grid-container {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 25px;
        }
        @media (max-width: 900px) {
            .grid-container {
                grid-template-columns: 1fr;
            }
        }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            position: relative;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--gold-gradient);
        }
        .card h3 {
            margin-top: 0;
            font-size: 16px;
            margin-bottom: 20px;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h3 i {
            color: #facc15;
        }
        .form-group {
            margin-bottom: 16px;
        }
        .form-group label {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 500;
        }
        .form-control {
            width: 100%;
            background: var(--bg-main);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 14px;
            color: var(--text-main);
            font-size: 13px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-control:focus {
            border-color: #facc15;
            box-shadow: 0 0 8px rgba(250, 204, 21, 0.2);
        }
        textarea.form-control {
            resize: vertical;
            height: 100px;
        }
        .btn-submit {
            background: var(--gold-gradient);
            color: #713f12;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 15px rgba(234, 179, 8, 0.3);
            transition: transform 0.2s, opacity 0.2s;
        }
        .btn-submit:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }
        .command-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .command-item {
            background: var(--bg-main);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .command-info .cmd-name {
            font-weight: 700;
            font-size: 14px;
            color: #facc15;
            margin-bottom: 4px;
            text-shadow: 0 0 8px rgba(250, 204, 21, 0.3);
        }
        .command-info .cmd-response {
            font-size: 12px;
            color: var(--text-muted);
        }
        .btn-delete {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.2);
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.2s;
        }
        .btn-delete:hover {
            background: rgba(239, 68, 68, 0.2);
        }
    </style>
</head>
<body>

    <!-- Incluimos la barra lateral desde partials -->
    <%- include('partials/sidebar') %>

    <div class="main-content">
        <div class="header-section">
            <h1>
                <i class="fa-solid fa-code"></i> Comandos Personalizados
            </h1>
            
            <!-- CONTROLES SUPERIORES: Campana, Idioma y Tema -->
            <div class="top-right-controls">
                
                <!-- CAMPANA DE NOTIFICACIONES -->
                <div class="notification-container" style="position: relative; display: inline-block; z-index: 10000;">
                    <button onclick="toggleNotificationMenu()" id="notificationBtn" class="theme-btn" title="Notificaciones" style="position: relative;">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>
                        <span style="position: absolute; top: 6px; right: 7px; width: 7px; height: 7px; background-color: #facc15; border-radius: 50%; box-shadow: 0 0 8px #facc15;"></span>
                    </button>
                    
                    <div id="notificationMenu" style="display: none; position: absolute; right: 0; top: 120%; width: 280px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); padding: 12px; z-index: 99999; text-align: left; backdrop-filter: blur(20px);">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 8px;">
                            <span style="font-weight: 700; font-size: 13px; color: var(--text-main);">🔔 Notificaciones</span>
                            <span style="font-size: 11px; color: var(--text-muted); cursor: pointer;" onclick="markAsRead()">Marcar leídas</span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="background: var(--bg-main); padding: 10px; border-radius: 10px; border: 1px solid var(--border);">
                                <div style="font-size: 12px; font-weight: 700; color: #facc15;">🚀 Actualización PREM</div>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Nuevas opciones de personalización ya disponibles.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SELECTOR DE IDIOMA -->
                <% 
                    const userLang = typeof currentLang !== 'undefined' ? currentLang : 'es';
                %>
                <div class="lang-dropdown" style="position: relative; display: inline-block; z-index: 1000;">
                    <button onclick="toggleLangMenu()" class="lang-btn">
                        <% 
                            let flag = '🇪🇸'; let langName = 'Español';
                            if (userLang === 'en') { flag = '🇺🇸'; langName = 'English'; }
                            else if (userLang === 'pt') { flag = '🇧🇷'; langName = 'Português'; }
                            else if (userLang === 'fr') { flag = '🇫🇷'; langName = 'Français'; }
                            else if (userLang === 'hi') { flag = '🇮🇳'; langName = 'हिन्दी'; }
                            else if (userLang === 'ar') { flag = '🇸🇦'; langName = 'العربية'; }
                            else if (userLang === 'zh') { flag = '🇨🇳'; langName = '中文'; }
                        %>
                        <span><%= flag %></span>
                        <span><%= langName %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
                    </button>
                    <div id="langMenu" style="display: none; position: absolute; right: 0; top: 120%; background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); overflow: hidden; min-width: 160px; z-index: 99999;">
                        <a href="/dashboard/custom-commands?lang=es" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇪🇸</span> Español</a>
                        <a href="/dashboard/custom-commands?lang=en" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇺🇸</span> English</a>
                        <a href="/dashboard/custom-commands?lang=pt" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇧🇷</span> Português</a>
                        <a href="/dashboard/custom-commands?lang=fr" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇫🇷</span> Français</a>
                        <a href="/dashboard/custom-commands?lang=hi" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇮🇳</span> हिन्दी</a>
                        <a href="/dashboard/custom-commands?lang=ar" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇸🇦</span> العربية</a>
                        <a href="/dashboard/custom-commands?lang=zh" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-main); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇨🇳</span> 中文</a>
                    </div>
                </div>

                <!-- BOTÓN DE TEMA (CLARO / OSCURO) -->
                <button class="theme-btn" onclick="toggleTheme()" title="Cambiar tono de pantalla">
                    <i class="fa-solid fa-moon" id="themeIcon"></i>
                </button>

            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px; margin-top: -15px;">
            <span class="badge-exclusive-gold">🌟 VIP EXCLUSIVE ACCESS</span>
        </div>

        <div class="grid-container">
            <!-- Formulario de Creación -->
            <div class="card">
                <h3><i class="fa-solid fa-plus-circle"></i> Crear Nuevo Comando</h3>
                <form id="commandForm">
                    <div class="form-group">
                        <label>Nombre del Comando (Ej: !hola o /reglas)</label>
                        <input type="text" id="cmdName" class="form-control" placeholder="!ejemplo" required autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label>Respuesta del Bot</label>
                        <textarea id="cmdResponse" class="form-control" placeholder="Escribe lo que responderá el bot..." required></textarea>
                    </div>
                    <button type="submit" class="btn-submit">Guardar Comando VIP</button>
                </form>
            </div>

            <!-- Lista de Comandos Existentes -->
            <div class="card">
                <h3><i class="fa-solid fa-list"></i> Tus Comandos Configurados</h3>
                <div class="command-list" id="commandList">
                    <div class="command-item">
                        <div class="command-info">
                            <div class="cmd-name">!reglas</div>
                            <div class="cmd-response">¡Hola! Recuerda mantener el respeto en el servidor de Discord.</div>
                        </div>
                        <button class="btn-delete" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Manejo de creación de comandos
        document.getElementById('commandForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('cmdName').value;
            const response = document.getElementById('cmdResponse').value;

            if(!name || !response) return;

            const list = document.getElementById('commandList');
            const newItem = document.createElement('div');
            newItem.className = 'command-item';
            newItem.innerHTML = `
                <div class="command-info">
                    <div class="cmd-name">${name}</div>
                    <div class="cmd-response">${response}</div>
                </div>
                <button class="btn-delete" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            list.appendChild(newItem);

            document.getElementById('commandForm').reset();
            alert('¡Comando personalizado creado con éxito!');
        });

        // Funciones para los menús desplegables y tema
        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationMenu');
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function markAsRead() {
            const badge = document.querySelector('#notificationBtn span');
            if (badge) badge.style.display = 'none';
        }

        function toggleLangMenu() {
            const menu = document.getElementById('langMenu');
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const currentTheme = html.getAttribute('data-theme');

            if (currentTheme === 'light') {
                html.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                localStorage.setItem('prem_theme', 'dark');
            } else {
                html.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                localStorage.setItem('prem_theme', 'light');
            }
        }

        // Cargar tema guardado al iniciar
        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('prem_theme') || 'dark';
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            
            html.setAttribute('data-theme', savedTheme);
            if (savedTheme === 'light') {
                themeIcon.className = 'fa-solid fa-sun';
            } else {
                themeIcon.className = 'fa-solid fa-moon';
            }
        });

        // Cerrar menús al hacer clic fuera
        window.onclick = function(event) {
            if (!event.target.closest('.notification-container')) {
                const menu = document.getElementById('notificationMenu');
                if (menu) menu.style.display = 'none';
            }
            if (!event.target.closest('.lang-dropdown')) {
                const menu = document.getElementById('langMenu');
                if (menu) menu.style.display = 'none';
            }
        }
    </script>

</body>
</html>