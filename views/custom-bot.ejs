<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'es' %>" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personalización de Bot - PREM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-gradient: #09090b;
            --card-bg: rgba(20, 18, 35, 0.8);
            --text-color: #ffffff;
            --text-muted: #a78bfa;
            --accent-color: #c084fc;
            --accent-glow: rgba(192, 132, 252, 0.4);
            --border-color: rgba(192, 132, 252, 0.2);
            --nav-bg: rgba(15, 12, 28, 0.9);
        }

        [data-theme="light"] {
            --bg-gradient: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.9);
            --text-color: #1e1b4b;
            --text-muted: #6b21a8;
            --accent-color: #9333ea;
            --accent-glow: rgba(147, 51, 234, 0.25);
            --border-color: rgba(147, 51, 234, 0.2);
            --nav-bg: rgba(255, 255, 255, 0.9);
        }

        body {
            background: var(--bg-gradient);
            background-attachment: fixed;
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background 0.3s ease, color 0.3s ease;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background-color: var(--nav-bg);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-color);
            font-weight: 800;
            font-size: 1.2rem;
        }

        .bot-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-color);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .top-right-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .lang-btn, .theme-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            font-size: 0.9rem;
            cursor: pointer;
            text-decoration: none;
        }

        .lang-btn:hover, .theme-btn:hover {
            border-color: var(--accent-color);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .theme-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            justify-content: center;
            padding: 0;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .container {
            max-width: 800px;
            width: 100%;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px;
            backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        h1 { color: var(--accent-color); margin-top: 0; }
        p { color: var(--text-muted); line-height: 1.6; }
        a.back-link { color: var(--accent-color); text-decoration: none; display: inline-block; margin-top: 20px; font-weight: 600; }
        a.back-link:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <% 
        const userLang = typeof lang !== 'undefined' ? lang : 'es';
        
        const translations = {
            es: {
                title: "Personalización de Bot",
                welcome: "Bienvenido",
                desc: "Aquí podrás configurar los ajustes globales de tu bot personalizado próximamente.",
                back: "Volver al panel de servidores",
                notifications: "Notificaciones",
                markRead: "Marcar leídas",
                updateTitle: "🚀 Actualización PREM",
                updateDesc: "Nuevas opciones de personalización ya disponibles."
            },
            en: {
                title: "Bot Customization",
                welcome: "Welcome",
                desc: "Here you will be able to configure the global settings of your custom bot soon.",
                back: "Back to servers panel",
                notifications: "Notifications",
                markRead: "Mark as read",
                updateTitle: "🚀 PREM Update",
                updateDesc: "New customization options now available."
            },
            pt: {
                title: "Personalização do Bot",
                welcome: "Bem-vindo",
                desc: "Aqui você poderá configurar as definições globais do seu bot personalizado em breve.",
                back: "Voltar ao painel de servidores",
                notifications: "Notificações",
                markRead: "Marcar lidas",
                updateTitle: "🚀 Atualização PREM",
                updateDesc: "Novas opções de personalização já disponíveis."
            },
            fr: {
                title: "Personnalisation du Bot",
                welcome: "Bienvenue",
                desc: "Ici, vous pourrez bientôt configurer les paramètres globaux de votre bot personnalisé.",
                back: "Retour au panneau des serveurs",
                notifications: "Notifications",
                markRead: "Marquer comme lu",
                updateTitle: "🚀 Mise à jour PREM",
                updateDesc: "De nouvelles options de personnalisation sont disponibles."
            },
            hi: {
                title: "बॉट कस्टमाइज़ेशन",
                welcome: "स्वागत है",
                desc: "यहाँ आप जल्द ही अपने कस्टम बॉट की वैश्विक सेटिंग को कॉन्फ़िगर कर सकेंगे।",
                back: "सर्वर पैनल पर वापस जाएं",
                notifications: "सूचनाएं",
                markRead: "पढ़ा हुआ मार्क करें",
                updateTitle: "🚀 PREM अपडेट",
                updateDesc: "नए कस्टमाइज़ेशन विकल्प अब उपलब्ध हैं।"
            },
            ar: {
                title: "تخصيص البوت",
                welcome: "أهلاً بك",
                desc: "هنا ستتمكن قريباً من تكوين الإعدادات العامة لبوتك المخصص.",
                back: "العودة إلى لوحة الخوادم",
                notifications: "الإشعارات",
                markRead: "تحديد كمقروء",
                updateTitle: "🚀 تحديث PREM",
                updateDesc: "خيارات تخصيص جديدة متاحة الآن."
            },
            zh: {
                title: "机器人自定义",
                welcome: "欢迎",
                desc: "您很快就能在此处配置自定义机器人的全局设置。",
                back: "返回服务器面板",
                notifications: "通知",
                markRead: "标记为已读",
                updateTitle: "🚀 PREM 更新",
                updateDesc: "新的自定义选项现已可用。"
            }
        };

        const t = translations[userLang] || translations['es'];
    %>

    <!-- BARRA SUPERIOR -->
    <nav>
        <a href="/dashboard" class="nav-left">
            <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="Bot Avatar" class="bot-avatar">
            <span>PREM</span>
        </a>

        <div class="top-right-controls">
            
            <!-- CAMPANA DE NOTIFICACIONES -->
            <div class="notification-container" style="position: relative; display: inline-block; z-index: 10000;">
                <button onclick="toggleNotificationMenu()" id="notificationBtn" class="theme-btn" title="<%= t.notifications %>" style="position: relative;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                    </svg>
                    <span style="position: absolute; top: 6px; right: 7px; width: 7px; height: 7px; background-color: var(--accent-color); border-radius: 50%; box-shadow: 0 0 8px var(--accent-color);"></span>
                </button>
                
                <div id="notificationMenu" style="display: none; position: absolute; right: 0; top: 125%; width: 280px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); padding: 12px; z-index: 99999; text-align: left; backdrop-filter: blur(20px);">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-bottom: 8px;">
                        <span style="font-weight: 700; font-size: 13px; color: var(--text-color);">🔔 <%= t.notifications %></span>
                        <span style="font-size: 11px; color: var(--text-muted); cursor: pointer;" onclick="markAsRead()"><%= t.markRead %></span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="background: rgba(0,0,0,0.1); padding: 10px; border-radius: 10px; border: 1px solid var(--border-color);">
                            <div style="font-size: 12px; font-weight: 700; color: var(--accent-color);"><%= t.updateTitle %></div>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;"><%= t.updateDesc %></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SELECTOR DE IDIOMA -->
            <div class="lang-dropdown" style="position: relative; display: inline-block; z-index: 1000;">
                <button onclick="toggleLangMenu()" class="lang-btn">
                    <% 
                        let flag = '🇪🇸'; let langName = 'Español';
                        if (userLang === 'en') { flag = '🇺🇸'; langName = 'English'; }
                        else if (userLang === 'pt') { flag = '🇧🇷'; langName = 'Português'; }
                        else if (userLang === 'fr') { flag = '🇫🇷'; langName = 'Français'; }
                        else if (userLang === 'hi') { flag = '🇮🇳'; langName = 'हिन्दी'; }
                        else if (userLang === 'ar') { flag = '🇸🇦'; langName = 'العربية'; }
                        else if (userLang === 'zh') { flag = '🇨🇳'; langName = '中文'; }
                    %>
                    <span><%= flag %></span>
                    <span><%= langName %></span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
                </button>
                <div id="langMenu" style="display: none; position: absolute; right: 0; top: 120%; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); overflow: hidden; min-width: 160px; z-index: 99999; backdrop-filter: blur(20px);">
                    <a href="/dashboard/custom-bot?lang=es" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇪🇸</span> Español</a>
                    <a href="/dashboard/custom-bot?lang=en" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇺🇸</span> English</a>
                    <a href="/dashboard/custom-bot?lang=pt" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇧🇷</span> Português</a>
                    <a href="/dashboard/custom-bot?lang=fr" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇫🇷</span> Français</a>
                    <a href="/dashboard/custom-bot?lang=hi" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇮🇳</span> हिन्दी</a>
                    <a href="/dashboard/custom-bot?lang=ar" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇸🇦</span> العربية</a>
                    <a href="/dashboard/custom-bot?lang=zh" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--text-color); text-decoration: none; font-size: 0.85rem;"><span style="font-size: 1rem;">🇨🇳</span> 中文</a>
                </div>
            </div>

            <!-- BOTÓN DE TEMA (CLARO / OSCURO) -->
            <button class="theme-btn" onclick="toggleTheme()" title="Cambiar tono de pantalla">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>

            <!-- MENÚ DESPLEGABLE DE PERFIL COMPLETO -->
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-dropdown-container" style="position: relative; display: inline-block; z-index: 1000;">
                    <div onclick="toggleUserMenu()" class="user-profile" style="display: flex; align-items: center; gap: 10px; background: var(--card-bg); padding: 6px 16px 6px 6px; border-radius: 30px; border: 1px solid var(--border-color); cursor: pointer;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #5865F2;">
                            <% if (user.avatar) { %>
                                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <img src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } %>
                        </div>
                        <span style="font-size: 14px; font-weight: 600; color: var(--text-color);"><%= user.global_name || user.username %></span>
                        <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted);"></i>
                    </div>

                    <div id="userDropdownMenu" style="display: none; position: absolute; right: 0; top: 125%; width: 280px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.6); z-index: 99999; padding: 12px; backdrop-filter: blur(20px);">
                        
                        <!-- Cabecera del Menú de Usuario -->
                        <div style="padding: 8px 10px; border-bottom: 1px solid var(--border-color); margin-bottom: 8px;">
                            <div style="font-weight: 700; font-size: 14px; color: var(--text-color);"><%= user.global_name || user.username %></div>
                            <div style="font-size: 12px; color: var(--text-muted);">@<%= user.username %></div>
                        </div>

                        <!-- Enlaces Principales -->
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <a href="/dashboard" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px; transition: background 0.2s;">
                                <i class="fa-solid fa-server" style="width: 16px; color: var(--accent-color);"></i> Mis servidores
                            </a>
                            <a href="#" onclick="toggleTheme(); return false;" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px; transition: background 0.2s;">
                                <i class="fa-solid fa-moon" style="width: 16px; color: var(--accent-color);"></i> Preferencias / Tema
                            </a>
                        </div>

                        <!-- Sección Gestión de PREM Bot -->
                        <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 800; letter-spacing: 0.5px; margin: 12px 0 6px 10px;">Gestión de PREM Bot</div>
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <a href="/dashboard/custom-bot" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <i class="fa-solid fa-robot" style="width: 16px; color: var(--accent-color);"></i> Personalización de Bot
                            </a>
                            <a href="/dashboard/custom-commands" style="display: flex; align-items: center; justify-content: space-between; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <i class="fa-solid fa-code" style="width: 16px; color: var(--accent-color);"></i> Comandos personalizados
                                </div>
                                <span style="background: linear-gradient(135deg, #fef08a, #facc15); color: #713f12; font-size: 9px; padding: 2px 8px; border-radius: 6px; font-weight: 800; box-shadow: 0 0 10px rgba(250, 204, 21, 0.4);">PREMIUM</span>
                            </a>
                        </div>

                        <!-- Sección Comunidad -->
                        <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 800; letter-spacing: 0.5px; margin: 12px 0 6px 10px;">Comunidad</div>
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <a href="https://discord.gg/soporte" target="_blank" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <i class="fa-brands fa-discord" style="width: 16px; color: #5865F2;"></i> Servidor de Soporte
                            </a>
                            <a href="/documentacion" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <i class="fa-solid fa-book" style="width: 16px; color: var(--accent-color);"></i> Documentación / Guías
                            </a>
                            <a href="https://top.gg" target="_blank" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-color); text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <i class="fa-solid fa-star" style="width: 16px; color: #facc15;"></i> Votar por el bot
                            </a>
                        </div>

                        <!-- Estado y Versión -->
                        <div style="border-top: 1px solid var(--border-color); margin-top: 10px; padding-top: 10px; display: flex; flex-direction: column; gap: 6px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 6px; font-size: 12px;">
                                <span style="color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                                    <span style="width: 6px; height: 6px; background-color: #22c55e; border-radius: 50%; box-shadow: 0 0 6px #22c55e;"></span> Estado de la API
                                </span>
                                <span style="color: #22c55e; font-weight: 600;">Operational</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 6px; font-size: 12px;">
                                <span style="color: var(--text-muted);">Versión actual</span>
                                <span style="color: var(--text-color); font-weight: 600;">PREM Bot v2.5</span>
                            </div>
                        </div>

                        <!-- Cerrar Sesión -->
                        <div style="border-top: 1px solid var(--border-color); margin-top: 10px; padding-top: 8px;">
                            <a href="/auth/logout" style="display: flex; align-items: center; gap: 12px; padding: 10px; color: #ef4444; text-decoration: none; border-radius: 10px; font-size: 13.5px;">
                                <i class="fa-solid fa-arrow-right-from-bracket" style="width: 16px;"></i> Cerrar sesión
                            </a>
                        </div>
                    </div>
                </div>
            <% } %>

        </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-wrapper">
        <div class="container">
            <h1><i class="fa-solid fa-robot"></i> <%= t.title %></h1>
            <p><%= t.welcome %>, <strong><%= user.global_name || user.username %></strong>. <%= t.desc %></p>
            <a href="/dashboard" class="back-link"><i class="fa-solid fa-arrow-left"></i> <%= t.back %></a>
        </div>
    </div>

    <script>
        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationMenu');
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function markAsRead() {
            const badge = document.querySelector('#notificationBtn span');
            if (badge) badge.style.display = 'none';
        }

        function toggleLangMenu() {
            const menu = document.getElementById('langMenu');
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleUserMenu() {
            const menu = document.getElementById('userDropdownMenu');
            if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleTheme() {
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            const currentTheme = html.getAttribute('data-theme');

            if (currentTheme === 'light') {
                html.setAttribute('data-theme', 'dark');
                themeIcon.className = 'fa-solid fa-moon';
                localStorage.setItem('prem_theme', 'dark');
            } else {
                html.setAttribute('data-theme', 'light');
                themeIcon.className = 'fa-solid fa-sun';
                localStorage.setItem('prem_theme', 'light');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('prem_theme') || 'dark';
            const html = document.documentElement;
            const themeIcon = document.getElementById('themeIcon');
            
            html.setAttribute('data-theme', savedTheme);
            if (savedTheme === 'light') {
                themeIcon.className = 'fa-solid fa-sun';
            } else {
                themeIcon.className = 'fa-solid fa-moon';
            }
        });

        window.onclick = function(event) {
            if (!event.target.closest('.notification-container')) {
                const menu = document.getElementById('notificationMenu');
                if (menu) menu.style.display = 'none';
            }
            if (!event.target.closest('.lang-dropdown')) {
                const menu = document.getElementById('langMenu');
                if (menu) menu.style.display = 'none';
            }
            if (!event.target.closest('.user-dropdown-container')) {
                const menu = document.getElementById('userDropdownMenu');
                if (menu) menu.style.display = 'none';
            }
        }
    </script>
</body>
</html>